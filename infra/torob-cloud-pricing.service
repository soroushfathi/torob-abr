[Unit]
Description=Torob Cloud bounded public pricing collector
After=network-online.target docker.service
Wants=network-online.target
[Service]
User=torob-pricing
Group=torob-pricing
ExecStart=/opt/torob-cloud/venv/bin/python /opt/torob-cloud/pricing/worker.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=160M
CPUQuota=15%
TasksMax=16
UMask=0077
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
