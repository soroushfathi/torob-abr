{
  "uid": "torob-technical",
  "title": "Torob Cloud \u00b7 Technical & AI",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "torob-cloud",
    "local-development"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Activity source",
        "type": "custom",
        "query": "user,verification",
        "current": {
          "text": "user",
          "value": "user"
        },
        "options": [
          {
            "text": "user",
            "value": "user",
            "selected": true
          },
          {
            "text": "verification",
            "value": "verification",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Topology & freshness",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Local application \u2192 authenticated loopback SSH tunnel \u2192 private telemetry gateway \u2192 existing Prometheus. **Offline \u2260 healthy.** Business aggregates continue from PostgreSQL while the development machine is offline. Raw application metrics disappear after 90 seconds."
      }
    },
    {
      "id": 2,
      "title": "Development machine online (0=offline)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "foroushyar-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "torob_dev_online{job=\"torob-cloud\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data / unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": ""
    },
    {
      "id": 3,
      "title": "Seconds since telemetry received",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "foroushyar-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-torob_telemetry_last_received_seconds{job=\"torob-cloud\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data / unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": ""
    },
    {
      "id": 4,
      "title": "Application requests / second",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "foroushyar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(torob_http_requests_total{job=\"torob-cloud\"}[5m])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data / unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": ""
    },
    {
      "id": 5,
      "title": "Application error share",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "foroushyar-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(torob_http_errors_total{job=\"torob-cloud\"}[5m])/clamp_min(rate(torob_http_requests_total{job=\"torob-cloud\"}[5m]),0.000001)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data / unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": ""
    },
    {
      "id": 6,
      "title": "Request latency p95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "foroushyar-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,rate(torob_http_duration_seconds_bucket{job=\"torob-cloud\"}[5m]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data / unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": ""
    },
    {
